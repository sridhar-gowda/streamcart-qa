# Copy to `.env` (gitignored). Secrets are read ONLY from the environment — never from YAML.
# In CI the same names are provided as GitHub Secrets / repository variables.

# --- credentials (persona → password; `default` is the fallback for every persona) ---
# SauceDemo publishes its shared password on the login page.
STREAMCART_USERS__DEFAULT__PASSWORD=
# STREAMCART_USERS__STANDARD__PASSWORD=
# STREAMCART_USERS__LOCKED_OUT__PASSWORD=

# --- selectors (optional; CLI flags override) ---
# STREAMCART_PLATFORM=web
# STREAMCART_ENV=dev
# STREAMCART_TARGET=chrome

# --- integrations (only needed when enabled) ---
# STREAMCART_TMS__PROVIDER=xray
# STREAMCART_TMS__BASE_URL=https://xray.cloud.getxray.app
# STREAMCART_TMS__PROJECT_KEY=SC
# STREAMCART_TMS__TOKEN=
# STREAMCART_ARTIFACTS__STORE=s3
# STREAMCART_ARTIFACTS__S3_BUCKET=
# STREAMCART_WEB__REMOTE_URL=https://USER:KEY@hub-cloud.browserstack.com/wd/hub

# --- build under test (CI sets this from the app pipeline) ---
# STREAMCART_BUILD=
